{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["transactionId", "requestId", "redirectURL", "status"],
  "properties": {
    "transactionId": { "type": "string", "pattern": "^txn_" },
    "requestId": { "type": "string", "pattern": "^req_" },
    "redirectURL": { "type": "string" },
    "status": { "enum": ["CREATED"] }
  }
}
