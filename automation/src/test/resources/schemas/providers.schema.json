{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["providerId", "providerName", "providerType", "status"],
    "properties": {
      "providerId": { "type": "string" },
      "providerName": { "type": "string" },
      "providerType": { "type": "string" },
      "status": { "enum": ["ACTIVE", "INACTIVE"] }
    }
  }
}
